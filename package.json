{
  "name": "@csheng/pi-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "description": "Small locally maintained Pi extensions that preserve the host agent loop",
  "files": [
    "config/",
    "extensions/"
  ],
  "keywords": [
    "pi-package",
    "multi-skill-mentions",
    "fast-gpt",
    "subagents",
    "herdr-handoff",
    "status-footer",
    "work-timing",
    "subagents-ui"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run test:fast && bun run test:isolated && bun run test:host-optional && bash -n scripts/*.sh",
    "e2e:installed-offline": "bash scripts/run-installed-workflow-probe.sh",
    "e2e:host-offline": "bun scripts/run-test-lane.ts host-required",
    "e2e:ui-offline": "bun scripts/run-test-lane.ts ui-required",
    "e2e:subagents": "bun scripts/run-live-subagents-e2e.ts",
    "e2e:subagents-ui": "bun test ./tests/subagents-ui-tui.e2e.ts",
    "test": "bun test --timeout 120000 ./tests/*.test.ts",
    "test:fast": "bun scripts/run-test-lane.ts fast",
    "test:isolated": "bun scripts/run-test-lane.ts isolated",
    "test:host-optional": "bun scripts/run-test-lane.ts host-optional",
    "typecheck": "bun run --bun tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.0",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "0.86.0",
    "@types/node": "^24.10.1",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/multi-skill-mentions/index.ts",
      "./extensions/fast-gpt/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/herdr-handoff/index.ts",
      "./extensions/status-footer/index.ts",
      "./extensions/work-timing/index.ts",
      "./extensions/subagents-ui/index.ts",
      "./extensions/workflow/index.ts"
    ]
  }
}
