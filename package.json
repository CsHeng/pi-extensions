{
  "name": "@csheng/pi-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Small locally maintained Pi extensions that preserve the host agent loop",
  "files": [
    "config/",
    "extensions/"
  ],
  "keywords": [
    "pi-package",
    "plan-mode",
    "multi-skill-mentions",
    "fast-gpt",
    "subagents",
    "herdr-handoff",
    "session-id-footer",
    "work-timing",
    "subagents-ui"
  ],
  "scripts": {
    "check": "npm run typecheck && npm test && bash -n scripts/*.sh",
    "e2e:subagents": "node --experimental-strip-types scripts/run-live-subagents-e2e.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^24.10.1",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/plan-mode/index.ts",
      "./extensions/multi-skill-mentions/index.ts",
      "./extensions/fast-gpt/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/herdr-handoff/index.ts",
      "./extensions/session-id-footer/index.ts",
      "./extensions/work-timing/index.ts"
    ]
  }
}
