{
  "name": "@csheng/pi-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Small locally maintained Pi extensions that preserve the host agent loop",
  "keywords": [
    "pi-package",
    "plan-mode",
    "multi-skill-mentions"
  ],
  "scripts": {
    "check": "npm run typecheck && npm test && bash -n scripts/*.sh",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/plan-mode/index.ts",
      "./extensions/multi-skill-mentions/index.ts"
    ]
  }
}
