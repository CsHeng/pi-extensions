# Copy to ignored .mise.local.toml only for a different local layout.
[env]
AGENT_ARCHITECTURE_DIR = "/path/to/agent-architecture"
AGENT_SKILLS_DIR = "/path/to/agent-skills"
PI_EXTENSIONS_DIR = "/path/to/pi-extensions"
# Optional override of the retained runtime/temporary root (default ~/tmp/agent-arch);
# see $AGENT_ARCHITECTURE_DIR/docs/contracts/workspace-and-repository-invariants.md.
# AGENT_TMP_ROOT = "/path/to/agent-arch-tmp"
